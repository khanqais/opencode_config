{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-opencode"],
  "model": "llm-proxy/gemini-cli-flash-proxy",
  "small_model": "llm-proxy/gemini-cli-flash-proxy",
  "provider": {
    "llm-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "VerysecretKey",
        "timeout": 300000
      },
      "models": {
        "gemini-cli-flash-proxy": {
          "id": "gemini_cli/gemini-2.5-flash",
          "name": "Gemini CLI 2.5 Flash",
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        },
        "gemini-cli-3-pro-proxy": {
          "id": "gemini_cli/gemini-3-pro-preview",
          "name": "Gemini CLI 3 Pro",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": ["image", "text", "video", "audio"],
            "output": ["text"]
          }
        },
        "gemini-cli-3-flash-proxy": {
          "id": "gemini_cli/gemini-3-flash-preview",
          "name": "Gemini CLI 3 Flash",
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        },
        "gemini-ag-3-pro-base-proxy": {
          "id": "antigravity/gemini-3-pro-preview",
          "name": "Gemini AG 3 Pro Base",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": ["image", "text", "video", "audio"],
            "output": ["text"]
          }
        },
        "gemini-ag-3-pro-high-proxy": {
          "id": "antigravity/gemini-3-pro-high",
          "name": "Gemini AG 3 Pro High Thinking",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "reasoning": true,
          "modalities": {
            "input": ["image", "text", "video", "audio"],
            "output": ["text"]
          }
        },
        "gemini-ag-3-pro-low-proxy": {
          "id": "antigravity/gemini-3-pro-low",
          "name": "Gemini AG 3 Pro Low Thinking",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "reasoning": true,
          "modalities": {
            "input": ["image", "text", "video", "audio"],
            "output": ["text"]
          }
        },
        "gemini-ag-3-flash-proxy": {
          "id": "antigravity/gemini-3-flash-preview",
          "name": "Gemini AG 3 Flash",
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        },
        "claude-sonnet-proxy": {
          "id": "antigravity/claude-sonnet-4-5",
          "name": "Claude Sonnet 4.5",
          "limit": {
            "context": 200000,
            "output": 8000
          },
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        },
        "claude-sonnet-thinking-proxy": {
          "id": "antigravity/claude-sonnet-4-5-thinking",
          "name": "Claude Sonnet 4.5 Thinking",
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "reasoning": true,
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        },
        "claude-opus-proxy": {
          "id": "antigravity/claude-opus-4-5",
          "name": "Claude Opus 4.5",
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "reasoning": true,
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        },
        "deepseek-v3-proxy": {
          "id": "iflow/deepseek-v3",
          "name": "DeepSeek V3",
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "options": {
            "max_tokens": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "deepseek-r1-proxy": {
          "id": "iflow/deepseek-r1",
          "name": "DeepSeek R1",
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "reasoning": true,
          "options": {
            "max_tokens": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "glm-4-proxy": {
          "id": "iflow/glm-4.6",
          "name": "GLM-4.6",
          "limit": {
            "context": 200000,
            "output": 4096
          },
          "options": {
            "max_tokens": 4096
          },
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
