{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-opencode"],
  "model": "llm-proxy/gemini-flash-proxy",
  "small_model": "llm-proxy/gemini-flash-proxy",
  "provider": {
    "llm-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "VerysecretKey",
        "timeout": 300000
      },
      "models": {
        "gemini-flash-proxy": {
          "id": "gemini_cli/gemini-2.5-flash",
          "name": "Gemini 2.5 Flash",
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        },
        "gemini-3-flash-proxy": {
          "id": "gemini_cli/gemini-3-flash-preview",
          "name": "Gemini 3 Flash",
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        },
        "gemini-25-flash-proxy": {
          "id": "antigravity/gemini-2.5-flash",
          "name": "Gemini 2.5 Flash AG",
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        },
        "claude-sonnet-proxy": {
          "id": "antigravity/claude-sonnet-4-5",
          "name": "Claude Sonnet 4.5",
          "limit": {
            "context": 200000,
            "output": 8000
          },
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        },
        "claude-sonnet-thinking-proxy": {
          "id": "antigravity/claude-sonnet-4-5-thinking",
          "name": "Claude Sonnet 4.5 Thinking",
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "reasoning": true,
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        },
        "claude-opus-proxy": {
          "id": "antigravity/claude-opus-4-5",
          "name": "Claude Opus 4.5",
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "reasoning": true,
          "modalities": {
            "input": ["image", "text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
