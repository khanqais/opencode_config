{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode"
  ],
  "model": "llm-proxy/gemini-cli-flash-proxy",
  "small_model": "llm-proxy/gemini-cli-flash-proxy",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "git add *": "deny",
      "git commit *": "deny",
      "git push *": "deny"
    }
  },
  "provider": {
