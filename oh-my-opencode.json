{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "llm-proxy/claude-opus-46-thinking-proxy",
      "temperature": 0.3
    },
    "oracle": {
      "model": "llm-proxy/deepseek-r1-proxy",
      "temperature": 0.1
    },
    "librarian": {
      "model": "llm-proxy/claude-sonnet-46-thinking-proxy",
      "temperature": 0.2
    },  
    "explore": {
      "model": "llm-proxy/gemini-cli-flash-proxy",
      "temperature": 0.3
    },
    "multimodal-looker": {
      "model": "llm-proxy/gemini-ag-31-pro-high-proxy",
      "temperature": 0.5
    },
    "prometheus": {
      "model": "llm-proxy/gpt-oss-120b-proxy",
      "temperature": 0.2
    },
    "metis": {
      "model": "llm-proxy/gemini-ag-31-pro-low-proxy",
      "temperature": 0.2
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "llm-proxy/gemini-ag-31-pro-high-proxy",
      "temperature": 0.7,
      "prompt_append": "Focus on modern UI/UX patterns, responsive design, and accessibility."
    },
    "ultrabrain": {
      "model": "llm-proxy/claude-opus-46-thinking-proxy",
      "temperature": 0.1,
      "prompt_append": "Apply deep strategic thinking and architectural reasoning."
    },
    "quick": {
      "model": "llm-proxy/gemini-cli-flash-proxy",
      "temperature": 0.3,
      "prompt_append": "Prioritize speed and efficiency."
    },
    "coding": {
      "model": "llm-proxy/deepseek-v3-proxy",
      "temperature": 0.2,
      "prompt_append": "Focus on clean, efficient code with best practices."
    },
    "reasoning": {
      "model": "llm-proxy/deepseek-r1-proxy",
      "temperature": 0.15,
      "prompt_append": "Use extended reasoning for complex problem-solving."
    },
    "backup-coding": {
      "model": "llm-proxy/claude-sonnet-46-thinking-proxy",
      "temperature": 0.2,
      "prompt_append": "High-quality code when DeepSeek is unavailable."
    },
    "multimodal": {
      "model": "llm-proxy/gemini-ag-31-pro-low-proxy",
      "temperature": 0.3,
      "prompt_append": "Handle image and text analysis tasks."
    }
  },
  "background_task": {
    "defaultConcurrency": 5,
    "providerConcurrency": {
      "llm-proxy": 8
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  }
}