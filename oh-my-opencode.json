{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  
  "agents": {
    "Sisyphus": {
      "model": "llm-proxy/claude-opus-4-5-thinking-proxy",
      "temperature": 0.3
    },
    "oracle": {
      "model": "llm-proxy/gpt-4-5-preview-proxy",
      "temperature": 0.1
    },
    "librarian": {
      "model": "llm-proxy/claude-sonnet-4-5-proxy",
      "temperature": 0.2
    },
    "explore": {
      "model": "llm-proxy/gemini-flash-proxy",
      "temperature": 0.3
    },
    "multimodal-looker": {
      "model": "llm-proxy/gemini-3-pro-high-proxy"
    },
    "Prometheus (Planner)": {
      "model": "llm-proxy/claude-opus-4-5-thinking-proxy",
      "temperature": 0.2
    },
    "Metis (Plan Consultant)": {
      "model": "llm-proxy/claude-sonnet-4-5-thinking-proxy",
      "temperature": 0.2
    }
  },
  
  "categories": {
    "visual-engineering": {
      "model": "llm-proxy/gemini-3-pro-high-proxy",
      "temperature": 0.7,
      "prompt_append": "Focus on modern UI/UX patterns, responsive design, and accessibility."
    },
    "ultrabrain": {
      "model": "llm-proxy/gpt-4-5-preview-proxy",
      "temperature": 0.1,
      "prompt_append": "Apply deep strategic thinking and architectural reasoning."
    },
    "quick": {
      "model": "llm-proxy/gemini-flash-proxy",
      "temperature": 0.3,
      "prompt_append": "Prioritize speed and efficiency."
    }
  },
  
  "background_task": {
    "defaultConcurrency": 5,
    "providerConcurrency": {
      "llm-proxy": 8
    }
  },
  
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  }
}
